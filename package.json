{
  "name": "quizlab-frontend-tooling",
  "private": true,
  "description": "Development-only linting and formatting for QuizLab static assets. Not needed at runtime.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:css": "stylelint \"app/static/css/**/*.css\"",
    "lint:js": "eslint app/static/js",
    "format:check": "prettier --check \"app/static/**/*.{css,js}\"",
    "format": "prettier --write \"app/static/**/*.{css,js}\"",
    "check": "npm run lint:css && npm run lint:js && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
