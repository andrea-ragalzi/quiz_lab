# Generate a unique secret; never use this placeholder in production.
SECRET_KEY=replace-with-a-long-random-secret
# Absolute SQLite URL. Omit to use instance/quizlab.sqlite.
# DATABASE_URL=sqlite:////home/yourusername/quizlab/instance/quizlab.sqlite
# Use 0 only for local HTTP development. Production HTTPS uses 1.
COOKIE_SECURE=1

